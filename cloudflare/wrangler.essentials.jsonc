{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "james-realty-essentials",
  "main": "essentials-worker.js",
  "compatibility_date": "2026-08-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "essentials.jamesrealty.uk", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
